# audit-vm-init.allow: the known callers of first-use system calls in the decoder VM program (tools/audit-vm-init.sh),
# "TARGET CALLER" with mangled names, grouped by why a worker never makes that call. A new caller fails the audit
# until it is understood and added here with its reason.

# Warmed up in the broker before the zygote forks any worker (vm/decoder_vm.cpp warm_up_libc and warm_up, fmt_heif.cpp
# warm_up_heif): bionic's string function dispatch, getpagesize, zlib's CPU check (the PNG warm-up), dav1d's set-up
# and its 12-bit transform tables (the 12-bit AVIF warm-up). scudo is the broker's own heap, set up at start: a
# worker allocates from its arena only (malloc and the rest are wrapped).
__cxa_guard_acquire _Z9page_sizev
__cxa_guard_acquire getpagesize
__cxa_guard_acquire memchr
__cxa_guard_acquire memcmp
__cxa_guard_acquire memcpy
__cxa_guard_acquire memmove
__cxa_guard_acquire memrchr
__cxa_guard_acquire memset
__cxa_guard_acquire stpcpy
__cxa_guard_acquire strchr
__cxa_guard_acquire strchrnul
__cxa_guard_acquire strcmp
__cxa_guard_acquire strcpy
__cxa_guard_acquire strlen
__cxa_guard_acquire strncmp
__cxa_guard_acquire strnlen
__cxa_guard_acquire strrchr
__cxa_guard_acquire wcslen
__cxa_guard_acquire wmemchr
clock_gettime _ZN5scudo16getMonotonicTimeEv
clock_gettime _ZN5scudo20getMonotonicTimeFastEv
gettid _ZN5scudo11getThreadIDEv
pthread_once _ZN5scudo18TSDRegistrySharedTINS_9AllocatorINS_19AndroidNormalConfigEXadL_Z21scudo_malloc_postinitEEEELj8ELj2EE10initThreadEPS3_
pthread_once adler32_z
pthread_once cpu_check_features
pthread_once crc32
pthread_once crc32_z
pthread_once dav1d_init_last_nonzero_col_from_eob_tables
pthread_once dav1d_itx_dsp_init_16bpc
pthread_once dav1d_open
sched_getaffinity _ZN5scudo15getNumberOfCPUsEv

# The broker, the zygote and process start only, never after a worker's lockdown: the broker's clock and I/O loops,
