// The decode service: untrusted media is decoded inside a protected VM for MediaProvider and other system callers.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// The decode service's API for MediaProvider, SystemUI and the system server. MediaProvider compiles a copy of these
// files into its module, so a change here is a change to both sides.
aidl_interface {
    name: "de.diamaneos.sanitizer.decode",
    srcs: ["aidl/de/diamaneos/sanitizer/decode/*.aidl"],
    local_include_dir: "aidl",
    unstable: true,
    backend: {
        java: {
            sdk_version: "system_current",
            min_sdk_version: "30",
            apex_available: [
                "//apex_available:platform",
                "com.android.mediaprovider",
            ],
        },
        cpp: {
            enabled: false,
        },
        ndk: {
            enabled: false,
        },
    },
}

// The callers' side in one library: the API and the checks every caller applies to what the service returns
// (DecodeChecks). MediaProvider, SystemUI and the system server link this instead of keeping copies. Where a copy
// cannot be avoided, tools/check-client-copy.sh compares it with these files.
java_library {
    name: "de.diamaneos.sanitizer.decode-client",
    srcs: ["client/**/*.java"],
    static_libs: ["de.diamaneos.sanitizer.decode-java"],
    sdk_version: "system_current",
    min_sdk_version: "30",
    apex_available: [
        "//apex_available:platform",
        "com.android.mediaprovider",
    ],
}

// The decoder VM's program and its decoders, for the device and the build machine alike. Every library is the tree's
// own, unchanged: libjpeg-turbo, libpng, libwebp, libhevc, dav1d, piex, and Wuffs (one C file, compiled into
// vm/fmt_wuffs.cpp with the modules it needs). The link wraps the C allocator, so that in a worker every library's
// malloc comes from the worker's fixed arena (vm/arena.cpp).
cc_defaults {
    name: "decoder_vm_common",
    srcs: [
        "vm/arena.cpp",
        "vm/decoder_vm.cpp",
        "vm/fmt_dng.cpp",
        "vm/fmt_heif.cpp",
        "vm/fmt_ico.cpp",
        "vm/fmt_webp.cpp",
        "vm/fmt_wuffs.cpp",
        "vm/meta.cpp",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    // No thread-safe function-local statics: their guard asks for the thread id on first use, a system call a worker
    // may not make. The program has no threads.
    cppflags: ["-fno-threadsafe-statics"],
    static_libs: [
        "libjpeg",
        "libpng",
        "libz",
        "libwebp-decode",
        "libhevcdec",
        "libdav1d",
        "libpiex",
        "libbinary_parse",
        "libimage_type_recognition",
        "libtiff_directory",
        // For its header only: vm/fmt_wuffs.cpp compiles the file itself, with every function static.
        "libwuffs_mirror_release_c",
    ],
    ldflags: [
        "-Wl,--wrap=malloc",
        "-Wl,--wrap=calloc",
        "-Wl,--wrap=realloc",
        "-Wl,--wrap=free",
        "-Wl,--wrap=posix_memalign",
        "-Wl,--wrap=memalign",
        "-Wl,--wrap=aligned_alloc",
        "-Wl,--wrap=malloc_usable_size",
    ],
    target: {
        // bionic's setjmp saves the signal mask, a system call a worker may not make (vm/decoder_vm.cpp).
        // tools/audit-vm-init.sh checks that nothing calls setjmp or sigsetjmp itself.
        android_arm64: {
            ldflags: ["-Wl,--wrap=setjmp"],
        },
        android_x86_64: {
            ldflags: ["-Wl,--wrap=setjmp"],
        },
    },
}

// The decoder VM's whole userspace: one static program, /init of a raw protected VM. Built for the device, never
// installed on it: it goes into the VM's initramfs. Linked with the platform's BTI check: every object carries the
// BTI property, so the kernel enforces BTI for all of the program. libhevc's arm64 assembly has no landing pads and
// stays out of the link (vm/fmt_heif.cpp defines the one function that would pull it in).
cc_defaults {
    name: "decoder_vm_defaults",
    defaults: ["decoder_vm_common"],
    static_executable: true,
    stl: "libc++_static",
    installable: false,
    compile_multilib: "64",
}

cc_binary {
    name: "decoder_vm_init",
    defaults: ["decoder_vm_defaults"],
}

// Test only: the same program with hooks that break a worker's lockdown on purpose. A cc_test, so no product can
// install it into an image (tests go only to the data partition, and this one is not installable at all), and the
// product's initramfs is built from decoder_vm_init alone.
cc_test {
    name: "decoder_vm_init_test",
    defaults: ["decoder_vm_defaults"],
    cflags: ["-DDECODER_TEST_HOOKS"],
    gtest: false,
    auto_gen_config: false,
}

// Test only: the same program for the build machine, listening on a Unix socket instead of vsock and staying the
// build user (it cannot change users), with the test hooks. The host checks run the real broker, zygote, workers,
// lockdown and decoders through it, without a phone.
cc_binary_host {
    name: "decoder_vm_hosttest",
    defaults: ["decoder_vm_common"],
    cflags: [
        "-DDECODER_HOST_TEST",
        "-DDECODER_TEST_HOOKS",
    ],
}

// The initramfs: /init and the empty directories it mounts on. Fixed owner, times and inode numbers, so the same
// program always gives the same bytes and the same signature. The virtualization APEX takes it with our guest kernel
// as etc/decoder_vm_initrd.img and etc/fs/decoder_vm_kernel, so release signing signs both again with the key pvmfw
// trusts (docs/virt-apex.md).
python_binary_host {
    name: "decoder_vm_mkinitrd",
    main: "vm/mkinitrd.py",
    srcs: ["vm/mkinitrd.py"],
}

genrule {
    name: "decoder_vm_initrd",
    tools: ["decoder_vm_mkinitrd"],
    device_first_srcs: [":decoder_vm_init"],
    out: ["initrd.img"],
    cmd: "$(location decoder_vm_mkinitrd) $(out) $(in)",
}

// Test only: the initramfs with the hook binary, for the self-test. Nothing installs it.
genrule {
    name: "decoder_vm_initrd_test",
    tools: ["decoder_vm_mkinitrd"],
    device_first_srcs: [":decoder_vm_init_test"],
    out: ["initrd-test.img"],
    cmd: "$(location decoder_vm_mkinitrd) $(out) $(in)",
}

android_app {
    name: "DiamaneOSSanitizer",
    srcs: ["java/**/*.java"],
    resource_dirs: ["res"],
    static_libs: ["de.diamaneos.sanitizer.decode-client"],
    sdk_version: "system_current",
    certificate: "platform",
    privileged: true,
    privapp_allowlist: "permissions/privapp-permissions-de.diamaneos.sanitizer.xml",
    system_ext_specific: true,
}

// Test builds only, installed by hand as an ordinary app: the service's classes and the self-test activity. In no
// product's packages: a build only puts it into its output folder (an uninstallable app would leave out its code).
android_app {
    name: "DiamaneOSSanitizerTest",
    package_name: "de.diamaneos.sanitizer.test",
    manifest: "test/AndroidManifest.xml",
    srcs: [
        "java/**/*.java",
        "test/java/**/*.java",
    ],
    resource_dirs: ["res"],
    static_libs: ["de.diamaneos.sanitizer.decode-client"],
    sdk_version: "system_current",
    system_ext_specific: true,
}
