<!-- The decode service: untrusted media is decoded inside a protected VM, for MediaProvider and other system
     components. No activity, nothing for apps to start. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="de.diamaneos.sanitizer">

    <!-- Callers of the decode service (IDecodeService): MediaProvider and other system components, allowlisted as
         privileged permissions. The service also checks the calling package against its own list. -->
    <permission
        android:name="de.diamaneos.sanitizer.permission.DECODE"
        android:protectionLevel="signature|privileged" />

    <uses-permission android:name="android.permission.MANAGE_VIRTUAL_MACHINE" />
    <uses-permission android:name="android.permission.USE_CUSTOM_VIRTUAL_MACHINE" />
    <!-- One service and one VM for every user and profile: callers include the system server and SystemUI. -->
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" />
    <uses-feature android:name="android.software.virtualization_framework" android:required="true" />

    <application
        android:name=".DecoderApp"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:persistent="true"
        android:directBootAware="true"
        android:usesNonSdkApi="true">
        <service
            android:name=".DecodeService"
            android:exported="true"
            android:directBootAware="true"
            android:singleUser="true"
            android:permission="de.diamaneos.sanitizer.permission.DECODE">
            <intent-filter>
                <action android:name="de.diamaneos.sanitizer.action.DECODE" />
            </intent-filter>
        </service>
        <!-- The health check for the release suite: only its dump, which only shell or root can run (dumpsys). -->
        <provider
            android:name=".HealthProvider"
            android:authorities="de.diamaneos.sanitizer.health"
            android:exported="false"
            android:directBootAware="true" />
    </application>
</manifest>
